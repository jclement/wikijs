doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='robots', content='noindex, nofollow')
    title #{title} | #{config.title}
    style.
      :root { color-scheme: light dark; --fg: #1c1e21; --muted: #5f6b7a; --bg: #f3f5f8; --card: #fff; --line: #d9dee5; --accent: #1976d2; --danger: #c62828; }
      @media (prefers-color-scheme: dark) { :root { --fg: #e8eaed; --muted: #9aa5b1; --bg: #15181c; --card: #1f2329; --line: #333a43; --accent: #64b5f6; --danger: #ef9a9a; } }
      * { box-sizing: border-box; }
      body { margin: 0; padding: 32px 16px; font: 16px/1.5 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; color: var(--fg); background: var(--bg); }
      main { max-width: 520px; margin: 0 auto; padding: 28px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
      h1 { margin: 0 0 4px; font-size: 22px; }
      p { margin: 12px 0; }
      .muted { color: var(--muted); font-size: 14px; }
      .box { margin: 16px 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; overflow-wrap: anywhere; }
      .box strong { display: block; }
      ul { margin: 8px 0; padding: 0; list-style: none; }
      li { padding: 6px 0; }
      label { display: flex; gap: 10px; align-items: flex-start; }
      input[type=checkbox] { margin-top: 5px; }
      .actions { display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; }
      button { padding: 9px 18px; font: inherit; border-radius: 6px; border: 1px solid var(--line); background: transparent; color: var(--fg); cursor: pointer; }
      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      button.danger { color: var(--danger); border-color: var(--danger); }
      code { font-size: 14px; overflow-wrap: anywhere; }
      .row { display: flex; gap: 12px; justify-content: space-between; align-items: center; }
  body
    main
      block content
